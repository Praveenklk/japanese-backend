generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Hiragana characters
 * Example: あ, い, う
 */
model Hiragana {
  id          String  @id @default(uuid())
  symbol      String // あ
  romaji      String // a
  explanation String // usage explanation
  example     String? // あめ

  imageUrl String? // Cloudinary URL   
  audioUrl String? // /audio/hiragana/a.mp3
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())
}

/**
 * Katakana characters
 * Example: ア, イ, ウ
 */
model Katakana {
  id          String  @id @default(uuid())
  symbol      String // ア
  romaji      String // a
  explanation String // used for foreign words
  example     String? // アイス

  imageUrl String? // Cloudinary URL (optional)
  audioUrl String? // /audio/katakana/a.mp3 (optional)
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // hashed password
  role     Role   @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

/**
 * Vocabulary words (JLPT based)
 */
model Vocabulary {
  id               String   @id @default(uuid())

  // Core word data
  japanese         String   // こんにちは
  reading          String   // Konnichiwa
  english          String   // Hello / Good afternoon

  // Organization
  category         String   // greetings, food, verbs, etc.
  difficulty       Difficulty @default(BEGINNER)
  jlptLevel        JLPT       @default(N5)
  tags             String[]   @default([])
  lessonNumber Int?
  explanation String? // 👈 ADD THIS


  // Usage examples
  example          String   // こんにちは、お元気ですか？
  exampleReading   String   // Konnichiwa, ogenki desu ka?
  exampleEnglish   String   // Hello, how are you?

  // Media
  imageUrl         String?
  audioUrl         String?
  pitchAccent      String?  // optional (later use)

  // Learning state
  isLearned        Boolean  @default(false)
  isBookmarked     Boolean  @default(false)

  // Review statistics
  reviews          Int      @default(0)
  correctCount     Int      @default(0)
  incorrectCount   Int      @default(0)
  streak           Int      @default(0)

  // Anki / Spaced repetition core
  lastReviewedAt   DateTime?
  nextReviewAt     DateTime? @default(now())
  intervalDays     Int      @default(1)    // 1, 3, 7, 15...
  easeFactor       Float    @default(2.5)  // SM-2 base

  // System
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([nextReviewAt])
  @@index([jlptLevel, difficulty])
}


/**
 * JLPT Levels
 */
enum JLPT {
  N5
  N4
  N3
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
