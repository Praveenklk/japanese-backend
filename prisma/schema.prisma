generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Hiragana characters
 * Example: あ, い, う
 */
model Hiragana {
  id          String  @id @default(uuid())
  symbol      String // あ
  romaji      String // a
  explanation String // usage explanation
  example     String? // あめ

  imageUrl String? // Cloudinary URL   
  audioUrl String? // /audio/hiragana/a.mp3
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())
}

/**
 * Katakana characters
 * Example: ア, イ, ウ
 */
model Katakana {
  id          String  @id @default(uuid())
  symbol      String // ア
  romaji      String // a
  explanation String // used for foreign words
  example     String? // アイス

  imageUrl String? // Cloudinary URL (optional)
  audioUrl String? // /audio/katakana/a.mp3 (optional)
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // hashed password
  role     Role   @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

/**
 * Vocabulary words (JLPT based)
 */
model Vocabulary {
  id          String  @id @default(uuid())
  word        String // たべます
  meaning     String // eat
  explanation String // polite verb form
  example     String // パンを たべます。
  level       JLPT    @default(N5)
  imageUrl    String? // Cloudinary URL
  audioUrl    String? // /audio/vocab/tabemasu.mp3
  isRead      Boolean @default(false)

  createdAt DateTime @default(now())
}

/**
 * JLPT Levels
 */
enum JLPT {
  N5
  N4
  N3
}
